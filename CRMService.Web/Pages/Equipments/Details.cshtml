@page "/equipments/{id:int}"
@model CRMService.Web.Pages.Equipments.DetailsModel
@{
    ViewData["Title"] = "Оборудование";
}

<div class="min-vh-100 bg-light p-3">
    <div id="pageError" class="alert alert-danger d-none mb-3"></div>

    <div class="bg-white border rounded-3 shadow-sm p-3 mb-3">
        <a class="btn btn-outline-secondary" href="@Model.BackUrl">Назад к списку оборудования</a>
    </div>

    <div id="equipmentDetailsPage"
         class="bg-white border rounded-3 shadow-sm p-3"
         data-equipment-id="@Model.EquipmentId">
        <div id="equipmentDetailsContent" class="text-muted">Загрузка...</div>
    </div>
</div>

<script src="~/js/helpers/http.js" asp-append-version="true"></script>
<script src="~/js/equipments/details.js" asp-append-version="true"></script>
